APP_NAME="Kiosk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/kiosk/public
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kiosk
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=www.kiosk.mirrorageconcepts.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
KIOSK_IDLE_TIMEOUT_MINUTES=30
KIOSK_SOCIAL_FACEBOOK=https://www.facebook.com/mirrorageconcepts
KIOSK_SOCIAL_INSTAGRAM=https://www.instagram.com/mirrorageconcepts
KIOSK_SOCIAL_X=https://x.com/mirrorageconcepts
KIOSK_SOCIAL_TIKTOK=https://www.tiktok.com/@mirrorageconcepts

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_TIMEOUT=15
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@mirrorageconcepts.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_APP_URL=https://www.mirrorageconcepts.com
PAYSTACK_CALLBACK_ROUTE=payments.paystack.callback
PAYSTACK_WEBHOOK_PATH=/webhooks/paystack
PAYSTACK_TIMEOUT_SECONDS=30
PAYSTACK_CONNECT_TIMEOUT_SECONDS=10
PAYSTACK_FORCE_IPV4=true
PAYSTACK_VERIFY_SSL=true

MARKETPLACE_SYNC_ENABLED=true
MARKETPLACE_SYNC_PRUNE_MISSING=true
MARKETPLACE_SYNC_TIMEOUT_SECONDS=20
MARKETPLACE_SYNC_SCHEDULE=hourly
MARKETPLACE_JUMIA_ENABLED=true
MARKETPLACE_JUMIA_FEED_URL=
MARKETPLACE_TEMU_ENABLED=true
MARKETPLACE_TEMU_FEED_URL=
MARKETPLACE_ALIBABA_ENABLED=true
MARKETPLACE_ALIBABA_FEED_URL=
MARKETPLACE_ALIEXPRESS_ENABLED=true
MARKETPLACE_ALIEXPRESS_FEED_URL=
MARKETPLACE_JIJI_ENABLED=true
MARKETPLACE_JIJI_FEED_URL=
