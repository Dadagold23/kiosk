APP_NAME="Kiosk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.kiosk.mirrorageconcepts.com
APP_FORCE_HTTPS=true
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_cpanel_database_name
DB_USERNAME=your_cpanel_database_user
DB_PASSWORD=your_cpanel_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=www.kiosk.mirrorageconcepts.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

KIOSK_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61590489010576
KIOSK_SOCIAL_INSTAGRAM=https://www.instagram.com/mirrorageconcepts
KIOSK_SOCIAL_X=https://x.com/mirrorageconcepts
KIOSK_SOCIAL_TIKTOK=https://www.tiktok.com/@mirrorageconcepts


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=kiosk_production

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.mirrorageconcepts.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mirrorageconcepts.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ASSET_URL=https://www.kiosk.mirrorageconcepts.com

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_APP_URL=https://www.kiosk.mirrorageconcepts.com
PAYSTACK_CALLBACK_ROUTE=payments.paystack.callback
PAYSTACK_WEBHOOK_PATH=/webhooks/paystack
PAYSTACK_TIMEOUT_SECONDS=30
PAYSTACK_CONNECT_TIMEOUT_SECONDS=10
PAYSTACK_FORCE_IPV4=true
PAYSTACK_VERIFY_SSL=true

